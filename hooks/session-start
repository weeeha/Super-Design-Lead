#!/usr/bin/env bash
# SessionStart hook for SuperLead plugin

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_skill_content=$(cat "${PLUGIN_ROOT}/skills/using-superlead/SKILL.md" 2>&1 || echo "Error reading using-superlead skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_skill_escaped=$(escape_for_json "$using_skill_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have leadership superpowers for design managers.\n\n**Below is the full content of your 'SuperLead:using-superlead' skill - your introduction to the design-management methodology. For all other skills, use the 'Skill' tool:**\n\n${using_skill_escaped}\n</EXTREMELY_IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
